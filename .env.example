# Everything is optional. With no keys set, MedEcho runs fully free and local.

# --- Core ---
MEDECHO_DEMO=0
MEDECHO_DB_URL=sqlite:///./medecho.db
MEDECHO_BASE_URL=http://localhost:8000

# --- Free local defaults ---
MEDECHO_STT=faster-whisper          # faster-whisper | openai
MEDECHO_WHISPER_MODEL=small
MEDECHO_TTS=edge                    # edge | azure | google
MEDECHO_OCR=tesseract               # tesseract | paddle
MEDECHO_GRADER=rules                # rules | llm
MEDECHO_SHEET_VLM=none              # none | anthropic | openai | ollama

# --- Optional LLM providers (grader, sheet VLM, LLM personas) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Optional cloud voices ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Optional real phone calls and SMS (Twilio) ---
MEDECHO_TRANSPORT=browser           # browser | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional email for the family message ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
